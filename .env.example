# Copy to .env and fill in real values. NEVER commit .env.
SECRET_KEY=
DEBUG=False
# Keep "localhost": the container healthcheck calls http://localhost:8000/health/
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost

# Cookies: set True only when the site is served over HTTPS
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email: dev uses the console backend (prints mails to the terminal).
# Production: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Database. For local SQLite, delete all DB_* lines. Docker uses Postgres with DB_HOST=db.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
